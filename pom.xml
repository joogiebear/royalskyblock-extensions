<?xml version="1.0" encoding="UTF-8"?>
<!--
  RoyalSkyblock extensions.

  One repository, one module per extension, one jar each. They share a parent because they share
  everything that is not their own code: the same JDK, the same provided dependencies, the same
  resource filtering for extension.yml, and the same install-deps script. A repository per extension
  would duplicate all of that four times over and let the copies drift.

  Each module produces a jar named after the extension, to be dropped in
  plugins/RoyalSkyblock/extensions/.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.mystipixel</groupId>
    <artifactId>royalskyblock-extensions</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <name>RoyalSkyblock Extensions</name>

    <modules>
        <module>ecoskills</module>
        <module>ecomobs</module>
        <!--
          ecominions is written but NOT built — see ecominions/BLOCKED.md.

          It is the only adapter that registers libreforge elements, so it is the only one that must
          compile against libreforge, and libreforge cannot be resolved by Maven: the published
          com.willfp:libreforge artifact is a 261-byte empty stub, and the real classes live in
          libreforge.core:common, which is in no public repository. Compiling against the shipped jar
          instead fails because its Kotlin is relocated, leaving the metadata unreadable.

          Left in the module list as a comment rather than deleted: the code is finished and correct,
          and the problem is the toolchain.
        -->
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>

        <!-- Kept in step with what the server actually runs; see tools/install-deps.ps1. -->
        <eco.version>2026.33</eco.version>
        <libreforge.version>2026.33</libreforge.version>
        <royalskyblock.version>2026.32.0</royalskyblock.version>
        <paper.version>26.2.build.40-alpha</paper.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <!--
          eco and libreforge come from here, NOT from the jars on the server.

          The shipped jars are shaded: their Kotlin is relocated to com.willfp.eco.libs.kotlin, which
          leaves the @Metadata unreadable to the Kotlin compiler. Java modules survive that - the
          Java-visible API is intact - but Kotlin ones do not: top-level functions like `arguments`
          and `get` disappear entirely, and open vals such as Condition.description stop being
          overridable. Compiling against the published artifacts is what makes a Kotlin extension
          possible at all.
        -->
        <repository>
            <id>auxilor</id>
            <url>https://repo.auxilor.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <!--
              All provided: an extension is loaded by RoyalSkyblock, inside the server, with eco and
              Paper already on the classpath. Shading any of them would put a second copy of eco in
              the same JVM, which is the fastest way to make an eco plugin stop recognising its own
              types.
            -->
            <dependency>
                <groupId>com.willfp</groupId>
                <artifactId>eco</artifactId>
                <version>${eco.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>com.willfp</groupId>
                <artifactId>libreforge</artifactId>
                <version>${libreforge.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>com.mystipixel</groupId>
                <artifactId>royalskyblock</artifactId>
                <version>${royalskyblock.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>io.papermc.paper</groupId>
                <artifactId>paper-api</artifactId>
                <version>${paper.version}</version>
                <scope>provided</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <!-- extension.yml carries ${project.version}, so it has to be filtered. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>
</project>
